# Salin ke .env.local dan isi nilai asli. Jangan commit .env.local.

# Wajib: secret untuk enkripsi cookie session (min 32 karakter)
IRON_SESSION_SECRET=ganti_dengan_secret_panjang_minimal_32_karakter!!

# Opsional: akun admin default yang dibuat otomatis saat pertama kali server nyala
ADMIN_EMAIL=admin@local.id
ADMIN_PASSWORD=admin123

# Opsional: custom path untuk file database SQLite
# DATABASE_PATH=/absolute/path/to/spkfc.db
