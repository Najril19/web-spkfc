# Salin ke .env.local. Jangan commit .env.local.
#
# Deploy (Railway/Vercel): salin variabel yang sama ke dashboard → Variables.
# File .env di repo TIDAK otomatis dipakai di server — wajib set manual di hosting.

# Wajib: connection string PostgreSQL (Neon: Dashboard → Connect → copy "psql" / connection string)
# Contoh: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
IRON_SESSION_SECRET=ganti_dengan_secret_panjang_minimal_32_karakter!!
ADMIN_EMAIL=admin@local.id
ADMIN_PASSWORD=admin123
